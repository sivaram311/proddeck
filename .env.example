# CSS IdP (server BFF / JWKS) + public issuer (client JWT iss check)
CSS_AUTH_URL=http://127.0.0.1:9000
NEXT_PUBLIC_CSS_ISSUER=http://localhost:9000

# password | hybrid (deck form + optional SSO) | oauth (treated as hybrid)
NEXT_PUBLIC_CSS_AUTH_MODE=password

# Optional OAuth redirect override (blank = use window.location.origin/auth/callback)
# NEXT_PUBLIC_CSS_OAUTH_REDIRECT_URI=

# Public ProdDeck URL (docs / SSR fallbacks / appliance tiles)
# NEXT_PUBLIC_APP_URL=https://home-dev.delena.buzz

# Hostnames treated as DEV for login UX (comma-separated)
NEXT_PUBLIC_DEV_HOSTS=localhost,127.0.0.1,home-dev.delena.buzz

# --- css-next hybrid pilot (DEV .env.local) ---
# CSS_AUTH_URL=https://css-next.delena.buzz
# NEXT_PUBLIC_CSS_ISSUER=https://css-next.delena.buzz
# NEXT_PUBLIC_CSS_AUTH_MODE=hybrid
# NEXT_PUBLIC_APP_URL=https://home-dev.delena.buzz

# Optional Agent Portal platform apps catalog (+ OS event forward base)
PLATFORM_APPS_URL=http://127.0.0.1:8080/api/platform/apps
# OS_EVENTS_FORWARD=1
